# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:devsecret@localhost:5632/hackathon

# --- OpenRouter (LLM gateway) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model slug works, e.g.:
#   anthropic/claude-sonnet-4.5
#   openai/gpt-5
#   google/gemini-2.5-flash
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Embeddings (used for pgvector) ---
# Needs its own key since OpenRouter doesn't serve embeddings.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small

# --- Langfuse (observability) ---
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- ScraperAPI (Amazon crawl via scripts/crawl_amazon.py) ---
SCRAPERAPI_KEY=xxxxxxxxxxxxxxxxxxxx

# --- App ---
CORS_ORIGINS=http://localhost:3000
